---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/url';
import PageHeader from '../../components/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import ContactCta from '../../components/ContactCta.astro';
import AppCard from '../../components/AppCard.astro';
import { APPLICATIONS } from '../../data/site';

export function getStaticPaths() {
  return APPLICATIONS.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const others = APPLICATIONS.filter((a) => a.slug !== app.slug);
---

<Layout title={app.metaTitle} description={app.metaDescription}>
  <PageHeader kicker="Applications" title={app.h1} lead={app.intro} />

  <section class="section">
    <div class="container">
      <div class="reveal">
        <SectionHead kicker="Parameters" title="What you can measure" />
      </div>
      <ul class="chips">
        {app.measures.map((m) => <li class="chip reveal">{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--gray">
    <div class="container">
      <div class="reveal">
        <SectionHead kicker="Use cases" title={`${app.title} in the field`} />
      </div>
      <div class="cases">
        {
          app.useCases.map((c, i) => (
            <article class="case reveal">
              <span class="case__bar" aria-hidden="true" />
              <span class="case__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="reveal">
        <SectionHead kicker="More applications" title="Explore the other fields" />
      </div>
      <div class="others">
        {
          others.map((o) => (
            <AppCard title={o.title} text={o.teaser} icon={o.icon} href={withBase(`/applications/${o.slug}`)} />
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta />
</Layout>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.35rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border);
    background: var(--white);
    font-weight: 600;
    font-size: 0.98rem;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .chip::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--blue), #7fb0ff);
    flex-shrink: 0;
  }
  .chip:hover {
    border-color: var(--blue);
    color: var(--blue);
    transform: translateY(-2px);
  }
  .cases {
    display: grid;
    gap: 1.25rem;
  }
  .case {
    position: relative;
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 2rem 1.75rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .case:hover {
    transform: translateY(-4px);
    border-color: rgba(3, 96, 232, 0.45);
    box-shadow: 0 16px 40px rgba(10, 10, 20, 0.08);
  }
  .case__bar {
    position: absolute;
    inset: 0 auto auto 0;
    height: 4px;
    width: 56px;
    background: linear-gradient(90deg, var(--blue), #5e97f2);
    border-radius: 0 0 4px 0;
    transition: width 0.35s ease;
  }
  .case:hover .case__bar {
    width: 100%;
    border-radius: 0;
  }
  .case__n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    background: linear-gradient(135deg, var(--blue) 0%, #7fb0ff 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .case h3 {
    font-size: 1.1rem;
  }
  .case p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .others {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .cases {
      grid-template-columns: repeat(3, 1fr);
    }
    .others {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
