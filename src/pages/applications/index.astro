---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/url';
import PageHeader from '../../components/PageHeader.astro';
import AppCard from '../../components/AppCard.astro';
import ContactCta from '../../components/ContactCta.astro';
import { APPLICATIONS } from '../../data/site';
---

<Layout
  title="NIR Spectroscopy Applications: Agriculture, Food, Counterfeit, Industrial | NIRStudio"
  description="Custom NIR spectroscopy applications for agriculture and feed, food quality and fraud detection, counterfeit product authentication, and industrial quality control. Built on demand for your industry."
>
  <PageHeader
    kicker="Applications"
    title="Your material, tested on the spot"
    lead="Every material is different, so every NIR model should be too. NIRStudio designs and builds a custom model around your specific samples, covering the full range of what you need to measure."
  />

  <section class="section">
    <div class="container">
      <div class="apps">
        {
          APPLICATIONS.map((app) => (
            <AppCard title={app.title} text={app.teaser} icon={app.icon} img={withBase(app.photo)} href={withBase(`/applications/${app.slug}`)} />
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta />
</Layout>

<style>
  .apps {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .apps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
