---
// Page Agriculture dédiée : reprend la structure de nirlab.com/agriculture
// (contenu du groupe NIRLAB / 908 Devices) dans le design system nirstudio.
// Cette route statique remplace la route dynamique [slug] pour "agriculture".
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/url';
import SectionHead from '../../components/SectionHead.astro';
import ContactCta from '../../components/ContactCta.astro';
import AppCard from '../../components/AppCard.astro';
import Icon from '../../components/Icon.astro';
import { APPLICATIONS, PORTAL_FEATURES } from '../../data/site';

const others = APPLICATIONS.filter((a) => a.slug !== 'agriculture');
const heroBg = `--agri-hero: url('${withBase('/img/agri/agri-hero.jpg')}')`;

// Résultats d'exemple par matériau (valeurs de démonstration nirlab.com).
const SAMPLES = [
  {
    id: 'corn',
    label: 'Corn',
    img: '/img/agri/corn.webp',
    params: [
      { name: 'Dry Matter', value: 86 },
      { name: 'Crude Protein', value: 9 },
      { name: 'Starch', value: 70 },
      { name: 'Digestibility', value: 90 },
      { name: 'NDF', value: 10 },
      { name: 'ADF', value: 5 },
      { name: 'Ash', value: 1 },
    ],
  },
  {
    id: 'silage',
    label: 'Silage',
    img: '/img/agri/silage.webp',
    params: [
      { name: 'Dry Matter', value: 36 },
      { name: 'Crude Protein', value: 15 },
      { name: 'Digestibility', value: 65 },
      { name: 'NDF', value: 40 },
      { name: 'ADF', value: 30 },
      { name: 'Sugar', value: 5 },
      { name: 'Ash', value: 4 },
    ],
  },
  {
    id: 'feed',
    label: 'Compound Feed',
    img: '/img/agri/feed.webp',
    params: [
      { name: 'Dry Matter', value: 88 },
      { name: 'Crude Protein', value: 20 },
      { name: 'Starch', value: 40 },
      { name: 'NDF', value: 17 },
      { name: 'ADF', value: 10 },
      { name: 'Sugar', value: 5 },
    ],
  },
];

// Matériaux analysables et leurs paramètres (field-to-fork).
const MATERIALS = [
  {
    id: 'soil',
    label: 'Soil',
    params: ['Nitrogen (N)', 'Phosphorus (P)', 'Potassium (K)', 'Organic matter', 'pH', 'Soil texture', 'Magnesium (Mg)', 'Calcium (Ca)', 'Other micronutrients'],
  },
  {
    id: 'tissue',
    label: 'Plant Tissue',
    params: ['Nitrogen (N)', 'Phosphorus (P)', 'Potassium (K)', 'Magnesium (Mg)', 'Calcium (Ca)', 'Other micronutrients'],
  },
  {
    id: 'feedsilage',
    label: 'Feed & Silages',
    params: ['Dry matter', 'Crude protein', 'Crude fiber', 'Starch', 'NDF', 'ADF', 'Ash', 'Fat', 'Energy values (NEL, ME, NEg)', 'Other parameters'],
  },
  {
    id: 'dairy',
    label: 'Dairy',
    params: ['Fat', 'Protein', 'Moisture / dry matter', 'Lactose', 'Total solids', 'Ash / minerals', 'Salt', 'pH', 'Adulteration detection', 'Other parameters'],
  },
  {
    id: 'manure',
    label: 'Manure',
    params: ['Total nitrogen (N)', 'Organic matter', 'DM/TS', 'Ammonia-N', 'Potassium (K)', 'Phosphorus (P)', 'Other parameters'],
  },
  {
    id: 'fertilizer',
    label: 'Fertilizer',
    params: ['Nitrogen (N)', 'Phosphorus (P)', 'Potassium (K)', 'Organic matter', 'Ammonium nitrogen', 'Nitrate nitrogen', 'Other micronutrients'],
  },
];

const FEATURES = [
  {
    icon: 'flask',
    title: 'On-site nutrients analyses',
    text: 'Instant results for key nutrients like protein, fat and moisture in grains, feed, manure and dairy, plus macro and micronutrients in soil, tissue and fertilizer.',
  },
  {
    icon: 'check',
    title: 'No sample preparation',
    text: 'All agro materials can be analyzed without any sample preparation, at the press of one button. Scan straight in the field and collect more insights.',
  },
  {
    icon: 'bolt',
    title: 'Instant results',
    text: 'The device connects to the mobile app via Bluetooth and scan results appear on a user-friendly app (iOS and Android) within seconds, with unlimited analyses per year.',
  },
  {
    icon: 'sparkles',
    title: 'Tailored to your needs',
    text: 'Each agricultural company faces unique challenges. We build high quality solutions tailored to your brand and technical needs: optimize processes, secure consistency, drive sustainability.',
  },
];

const NIRLIGHT_SPECS = [
  'Length: 20 cm, diameter: 5.5 cm',
  'Bluetooth or USB connectivity to tablet or PC',
  'Point-and-click with a multi-function button',
  'Rapid, real-time near-infrared analysis anywhere',
  'Up to 8 hours continuous operation, USB-C fast charging',
];

const FAQS = [
  {
    q: 'Can I use the same device for different types of samples like soil, manure, and plant tissue?',
    a: 'Yes. The same device can analyze multiple sample types. The key is selecting the right calibration model in the app: soil, manure or plant tissue, and following basic sample preparation guidelines.',
  },
  {
    q: 'Do I need an internet connection to scan samples in the field?',
    a: 'No. The device and app work fully offline for scanning. Once you have internet access, results sync to your personal web portal for storage and analysis.',
  },
  {
    q: 'How accurate are the results compared to laboratory analysis?',
    a: 'Our models are built from thousands of lab-analyzed samples. While NIR is not a replacement for certified laboratory testing in all cases, it provides fast, affordable and reliable values for on-site decision making.',
  },
  {
    q: 'Can I build my own calibrations for specific crops, soils, or regions?',
    a: 'Yes. We offer custom calibration development. This is ideal for companies, cooperatives or consultants working with specific regions or products.',
  },
  {
    q: 'How can I get technical support?',
    a: 'We offer technical support and are happy to share more details about our solution through email, phone calls or video conferences. Get in touch through our contact form.',
  },
