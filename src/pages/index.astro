---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { SITE, APPLICATIONS, STEPS, HARDWARE, QUOTE } from '../data/site';
---

<Layout
  title="NIR Studio | Custom NIR spectroscopy solutions, on demand"
  description={SITE.description}
>
  <!-- ============ HERO (background officiel du kit de marque) ============ -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1>Custom NIR solutions, on&nbsp;demand</h1>
        <p class="hero__lead">
          Your measurement problem, our chemometrics. NIR Studio designs tailored
          near-infrared spectroscopy applications: from data acquisition to a
          production-ready model in your team's hands.
        </p>
        <div class="hero__cta">
          <a href="#contact" class="btn btn--primary">Request a solution</a>
          <a href="#solution" class="btn btn--ghost">How it works</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SOLUTION ============ -->
  <section class="section" id="solution">
    <div class="container intro">
      <div class="intro__copy">
        <span class="kicker">Solution</span>
        <h2>The on-demand lab of 908&nbsp;Devices</h2>
        <p class="lead" style="margin-top: 1.25rem;">
          NIRLAB brought lab-grade NIR spectroscopy into a handheld device. Now part of
          908 Devices, our studio builds the applications on top: custom models for your
          substances, your matrices and your field conditions. You bring the problem, we
          deliver the solution.
        </p>
      </div>
      <img
        src="/img/solution-olives.jpg"
        alt="Handheld NIRLAB spectrometer with the mobile app showing oil and water content of an olive sample"
        width="1200"
        height="1000"
        loading="lazy"
        class="intro__img"
      />
    </div>
    <div class="container">
      <div class="grid grid--3">
        {
          STEPS.map((step) => (
            <article class="step">
              <span class="step__n">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ HARDWARE ============ -->
  <section class="section section--dark" id="hardware">
    <div class="container hardware">
      <div class="hardware__copy">
        <span class="kicker">Hardware</span>
        <h2>One device, every answer</h2>
        <div class="hardware__list">
          {
            HARDWARE.map((h) => (
              <article class="hardware__item">
                <span class="card__icon">
                  <Icon name={h.icon} />
                </span>
                <div>
                  <h3>{h.title}</h3>
                  <p>{h.text}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <img
        src="/img/fieldlab-phone.png"
        alt="Handheld NIRLAB spectrometer scanning a sample, with live results in the mobile app"
        width="867"
        height="765"
        loading="lazy"
        class="hardware__img"
      />
    </div>
  </section>

  <!-- ============ APPLICATIONS ============ -->
  <section class="section" id="applications">
    <div class="container">
      <span class="kicker">Applications</span>
      <h2>Built for your field</h2>
      <div class="grid grid--3">
        {
          APPLICATIONS.map((app) => (
            <article class="card">
              <span class="card__icon">
                <Icon name={app.icon} />
              </span>
              <h3>{app.title}</h3>
              <p>{app.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ QUOTE ============ -->
  <section class="section section--dark">
    <div class="container quote">
      <blockquote>
        <p class="quote__text">“{QUOTE.text}”</p>
        <footer class="quote__author">
          {QUOTE.author} <span>{QUOTE.role}</span>
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section" id="contact">
    <div class="container contact">
      <h2>Tell us what you need to measure</h2>
      <p class="lead" style="margin-inline: auto; margin-top: 1.25rem;">
        NIR Studio is made for professionals who want lab-grade answers in the field.
        Get in touch through 908 Devices and describe your use case.
      </p>
      <div class="contact__cta">
        <a href={SITE.contactUrl} class="btn btn--primary" target="_blank" rel="noopener">
          Contact us
          <Icon name="arrow" size={18} />
        </a>
        <a href={SITE.parent.url} class="btn btn--ghost-light" target="_blank" rel="noopener">
          Visit 908devices.com
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Hero : background officiel (device + phone dans l'image) ---------- */
  .hero {
    /* L'image place le produit à droite : le copy vit à gauche, comme nirlab.com */
    background: var(--ink) url('/img/hero-bg.jpg') no-repeat center right / cover;
    color: var(--text-on-dark);
    min-height: min(88vh, 780px);
    display: flex;
    align-items: center;
  }
  .hero__inner {
    width: 100%;
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .hero h1 {
    color: var(--white);
    max-width: 13ch;
  }
  .hero__lead {
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    color: #c7ccd4;
    max-width: 32rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }
  @media (max-width: 700px) {
    /* En mobile le produit reste visible mais sous un voile pour la lisibilité du texte */
    .hero {
      background:
        linear-gradient(180deg, rgba(10, 10, 12, 0.3) 0%, rgba(10, 10, 12, 0.78) 55%, rgba(10, 10, 12, 0.9) 100%),
        var(--ink) url('/img/hero-bg.jpg') no-repeat 72% center / cover;
    }
  }

  /* ---------- Solution (texte + render olives + étapes) ---------- */
  .intro {
    display: grid;
    gap: 3rem;
    align-items: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .intro__img {
    width: min(460px, 85%);
    justify-self: center;
    height: auto;
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.2fr 1fr;
    }
    .intro__img {
      width: 100%;
    }
  }

  /* ---------- Hardware (liste + render device) ---------- */
  .hardware {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .hardware__list {
    display: grid;
    gap: 1.75rem;
    margin-top: 2.5rem;
  }
  .hardware__item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .hardware__item p {
    color: #9ca3af;
    font-size: 0.95rem;
    margin-top: 0.4rem;
  }
  .hardware__item .card__icon {
    flex-shrink: 0;
  }
  .hardware__img {
    width: min(460px, 85%);
    justify-self: center;
    height: auto;
  }
  @media (min-width: 900px) {
    .hardware {
      grid-template-columns: 1.15fr 1fr;
    }
    .hardware__img {
      width: 100%;
    }
  }

  /* ---------- Grilles et cartes ---------- */
  .grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }
  .card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .card p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .card--dark {
    background: var(--ink-soft);
    border-color: var(--border-dark);
  }
  .card--dark p {
    color: #9ca3af;
  }
  .card__icon {
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(3, 96, 232, 0.1);
    color: var(--blue);
    margin-bottom: 0.25rem;
  }
  .card--dark .card__icon {
    color: #5e97f2;
    background: rgba(3, 96, 232, 0.16);
  }
  @media (min-width: 700px) {
    .grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .grid--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---------- Steps ---------- */
  .step {
    border-top: 3px solid var(--blue);
    padding-top: 1.25rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .step__n {
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--blue);
    letter-spacing: 0.08em;
  }
  .step p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  /* ---------- Quote ---------- */
  .quote {
    max-width: 56rem;
  }
  .quote__text {
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--white);
    text-wrap: balance;
  }
  .quote__author {
    margin-top: 1.75rem;
    font-weight: 700;
    color: var(--white);
  }
  .quote__author span {
    display: block;
    font-weight: 400;
    color: #9ca3af;
    font-size: 0.9rem;
  }

  /* ---------- Contact ---------- */
  .contact {
    text-align: center;
    max-width: 52rem;
  }
  .contact__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2.25rem;
  }
</style>
