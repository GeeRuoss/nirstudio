---
// Carte d'étape du process (Step 1 / Step 2 / Step 3, numérotation dans le titre).
interface Props {
  title: string;
  text: string;
}
const { title, text } = Astro.props;
---

<article class="stepcard reveal">
  <span class="stepcard__bar" aria-hidden="true"></span>
  <h3>{title}</h3>
  <p>{text}</p>
</article>

<style>
  .stepcard {
    position: relative;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 2.25rem 1.75rem 2rem;
    overflow: hidden;
    display: grid;
    gap: 0.65rem;
    align-content: start;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .stepcard:hover {
    transform: translateY(-4px);
    border-color: rgba(3, 96, 232, 0.45);
    box-shadow: 0 16px 40px rgba(10, 10, 20, 0.08);
  }
  /* Filet dégradé en tête de carte, s'étire au hover */
  .stepcard__bar {
    position: absolute;
    inset: 0 auto auto 0;
    height: 4px;
    width: 56px;
    background: linear-gradient(90deg, var(--blue), #5e97f2);
    border-radius: 0 0 4px 0;
    transition: width 0.35s ease;
  }
  .stepcard:hover .stepcard__bar {
    width: 100%;
    border-radius: 0;
  }
  .stepcard p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
