---
import { NAV, SITE } from '../data/site';
import { withBase } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href={SITE.parent.url} class="footer__908" target="_blank" rel="noopener" aria-label="908 Devices, parent company">
        <img src={withBase('/img/908devices-logo-white.png')} alt="908 Devices" width="640" height="108" />
      </a>
      <span class="footer__logo">
        <span class="footer__name">NIR<b>Studio</b></span>
      </span>
      <p>
        NIRStudio builds custom NIR spectroscopy applications, on demand: chemometric
        modeling, a handheld spectrometer and a cloud platform, delivered as one system.
        By the team behind NIRLAB, part of 908 Devices.
      </p>
    </div>

    <nav class="footer__col" aria-label="Pages">
      <span class="footer__title">Pages</span>
      {NAV.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>

    <nav class="footer__col" aria-label="Company">
      <span class="footer__title">Company</span>
      <a href={SITE.parent.url} target="_blank" rel="noopener">908devices.com</a>
      <a href={withBase('/#contact')}>Contact</a>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p>© {year} 908 Devices Inc. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: #94a3b8;
    padding-top: 4rem;
    font-size: 0.92rem;
    border-top: 1px solid var(--border-dark);
  }
  .footer__inner {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  /* Hiérarchie : 908devices (société) en principal, NIRStudio en sous-marque */
  .footer__908 {
    display: inline-block;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }
  .footer__908:hover {
    opacity: 1;
  }
  .footer__908 img {
    display: block;
    height: 30px;
    width: auto;
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--white);
    margin-top: 1.1rem;
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: 0.01em;
  }
  .footer__name b {
    font-weight: 300;
    color: var(--lightblue);
  }
  .footer__brand p {
    margin-top: 1rem;
    max-width: 24rem;
    line-height: 1.6;
  }
  .footer__col {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    justify-items: start;
  }
  .footer__title {
    font-weight: 700;
    color: var(--white);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .footer__col a {
    position: relative;
    transition: color 0.2s ease;
  }
  .footer__col a:hover {
    color: var(--white);
  }
  .footer__bottom {
    border-top: 1px solid var(--border-dark);
    padding-block: 1.5rem;
    font-size: 0.82rem;
    color: #6b7280;
  }
  @media (min-width: 900px) {
    .footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }
</style>
