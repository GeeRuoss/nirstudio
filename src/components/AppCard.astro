---
// Carte d'application (Agriculture / Food / Counterfeit).
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  icon: string;
}
const { title, text, icon } = Astro.props;
---

<article class="appcard reveal">
  <span class="appcard__icon">
    <Icon name={icon} size={26} />
  </span>
  <h3>{title}</h3>
  <p>{text}</p>
</article>

<style>
  .appcard {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 2rem 1.75rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .appcard:hover {
    transform: translateY(-4px);
    border-color: rgba(3, 96, 232, 0.45);
    box-shadow: 0 16px 40px rgba(10, 10, 20, 0.08);
  }
  .appcard__icon {
    display: inline-flex;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(3, 96, 232, 0.12), rgba(94, 151, 242, 0.18));
    color: var(--blue);
    margin-bottom: 0.5rem;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .appcard:hover .appcard__icon {
    background: linear-gradient(135deg, var(--blue), #4d8bf5);
    color: var(--white);
  }
  .appcard p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
