---
// Carte d'application cliquable (Agriculture / Food / Counterfeit / Industrial).
// Photo optionnelle en tête, gros titre Crystal, flèche, invert bleu au hover.
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  icon: string;
  href: string;
  img?: string;
}
const { title, text, icon, href, img } = Astro.props;
---

<a class="appcard reveal" href={href}>
  {
    img && (
      <span class="appcard__media">
        <img src={img} alt="" width="1200" height="675" loading="lazy" />
      </span>
    )
  }
  <span class="appcard__body">
    <span class="appcard__top">
      <span class="appcard__icon"><Icon name={icon} size={24} /></span>
      <span class="appcard__arrow" aria-hidden="true"><Icon name="arrow" size={22} /></span>
    </span>
    <span class="appcard__title">{title}</span>
    <p>{text}</p>
  </span>
</a>

<style>
  .appcard {
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    min-height: 280px;
    transition:
      transform 0.28s ease,
      background 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }
  .appcard__media {
    display: block;
    overflow: hidden;
  }
  .appcard__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .appcard:hover .appcard__media img {
    transform: scale(1.04);
  }
  .appcard__body {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.75rem;
  }
  .appcard__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .appcard__icon {
    display: inline-flex;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: rgba(3, 96, 232, 0.1);
    color: var(--blue);
    transition: background 0.28s ease, color 0.28s ease;
  }
  .appcard__arrow {
    color: var(--text-muted);
    opacity: 0.5;
    transition: transform 0.28s ease, color 0.28s ease, opacity 0.28s ease;
  }
  .appcard__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text);
    transition: color 0.28s ease;
  }
  .appcard p {
    color: var(--text-muted);
    font-size: 0.95rem;
    transition: color 0.28s ease;
  }

  /* Hover : la carte passe en bleu marque, tout s'inverse */
  .appcard:hover {
    background: var(--blue);
    border-color: var(--blue);
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgba(3, 96, 232, 0.28);
  }
  .appcard:hover .appcard__title {
    color: var(--white);
  }
  .appcard:hover p {
    color: rgba(255, 255, 255, 0.85);
  }
  .appcard:hover .appcard__icon {
    background: rgba(255, 255, 255, 0.16);
    color: var(--white);
  }
  .appcard:hover .appcard__arrow {
    color: var(--white);
    opacity: 1;
    transform: translateX(4px);
  }
</style>
