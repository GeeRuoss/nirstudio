---
// Bandeau final de contact : CTA vers 908 Devices.
import Icon from './Icon.astro';
import { SITE } from '../data/site';
---

<section class="section" id="contact">
  <div class="container contact reveal">
    <h2>Tell us what you need to measure</h2>
    <p class="lead">
      NIR Studio is made for professionals who want lab-grade answers in the field.
      Get in touch through 908 Devices and describe your use case.
    </p>
    <div class="contact__cta">
      <a href={SITE.contactUrl} class="btn btn--primary" target="_blank" rel="noopener">
        Contact us
        <Icon name="arrow" size={18} />
      </a>
      <a href={SITE.parent.url} class="btn btn--ghost-light" target="_blank" rel="noopener">
        Visit 908devices.com
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    text-align: center;
    max-width: 52rem;
  }
  .contact .lead {
    margin-inline: auto;
    margin-top: 1.25rem;
  }
  .contact__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2.25rem;
  }
</style>
