---
// Bandeau final de contact : grande carte en dégradé bleu marque, sur toutes les pages.
import Icon from './Icon.astro';
import { SITE } from '../data/site';
---

<section class="section" id="contact">
  <div class="container">
    <div class="cta reveal">
      <!-- Spectre NIR décoratif en filigrane -->
      <svg class="cta__wave" viewBox="0 0 900 300" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0 240 C90 230 130 150 200 145 S300 210 370 205 440 90 510 80 590 170 660 165 760 60 830 50 890 110 900 120"
          stroke="rgba(255,255,255,0.16)"
          stroke-width="3"
          stroke-linecap="round"
        />
        <path
          d="M0 275 C100 268 140 200 210 195 S310 245 380 240 450 140 520 132 600 210 670 205 770 115 840 108 895 150 900 158"
          stroke="rgba(255,255,255,0.07)"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>

      <div class="cta__content">
        <h2>Tell us what you need to&nbsp;measure</h2>
        <p>
          NIRStudio is made for professionals who want lab-grade answers in the field.
          Get in touch through our contact form and describe your use case.
        </p>
        <div class="cta__buttons">
          <a href={SITE.contactUrl} class="btn cta__primary" target="_blank" rel="noopener">
            Contact us
            <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    background:
      radial-gradient(90% 140% at 85% -10%, rgba(127, 176, 255, 0.35) 0%, transparent 55%),
      linear-gradient(135deg, #0d6bf0 0%, #0360e8 35%, #023f9e 100%);
    color: var(--white);
    padding: clamp(2.75rem, 6vw, 5rem) clamp(1.75rem, 5vw, 4.5rem);
    box-shadow: 0 32px 64px rgba(3, 96, 232, 0.25);
  }
  .cta__wave {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 65%;
    pointer-events: none;
  }
  .cta__content {
    position: relative;
    max-width: 40rem;
  }
  .cta h2 {
    color: var(--white);
    font-size: clamp(1.9rem, 4vw, 3rem);
  }
  .cta p {
    margin-top: 1.25rem;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    color: rgba(255, 255, 255, 0.82);
    max-width: 34rem;
  }
  .cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }
  .cta__primary {
    background: var(--white);
    color: var(--blue);
    font-weight: 700;
    box-shadow: 0 10px 26px rgba(2, 30, 80, 0.35);
  }
  .cta__primary:hover {
    transform: translateY(-2px);
    background: #f2f7ff;
    box-shadow: 0 16px 34px rgba(2, 30, 80, 0.45);
  }
</style>
