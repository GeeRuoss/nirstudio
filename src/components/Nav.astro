---
import { NAV, SITE } from '../data/site';
import { withBase } from '../lib/url';

// Page active pour souligner le lien courant (chemin sans le base path).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.slice(base.length) || '/').replace(/\/$/, '') || '/';
const isActive = (href: string) => href !== '/#contact' && path.startsWith(href);
---

<header class="nav">
  <div class="container nav__inner">
    <a href={withBase('/')} class="nav__brand" aria-label="NIR Studio, home">
      <!-- Chevrons du logo officiel NIRLAB (kit de marque 2026) -->
      <svg width="34" height="20" viewBox="0 0 92.13 53.19" fill="currentColor" aria-hidden="true">
        <polygon points="46.06 0 46.06 26.6 0 53.19 0 26.59 46.06 0" />
        <polygon points="92.13 0 92.13 26.6 46.07 53.19 46.06 53.19 46.06 26.6 92.13 0" />
      </svg>
      <span class="nav__name">NIR<b>STUDIO</b></span>
    </a>

    <nav class="nav__links" aria-label="Main">
      {
        NAV.map((item) => (
          <a href={withBase(item.href)} class:list={{ 'is-active': isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href={SITE.parent.url} class="nav__parent" target="_blank" rel="noopener">
      A 908 Devices Company
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: rgba(10, 10, 12, 0.82);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    color: var(--white);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .nav__brand svg {
    color: var(--blue);
  }
  .nav__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
  }
  .nav__name b {
    font-weight: 700;
  }
  .nav__links {
    display: none;
    gap: 2rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .nav__links a {
    position: relative;
    color: #cbd5e1;
    padding-block: 0.35rem;
    transition: color 0.2s ease;
  }
  /* Soulignement qui glisse au hover + état actif */
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s ease;
  }
  .nav__links a:hover {
    color: var(--white);
  }
  .nav__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav__links a.is-active {
    color: var(--white);
  }
  .nav__links a.is-active::after {
    transform: scaleX(1);
  }
  .nav__parent {
    font-size: 0.78rem;
    font-weight: 600;
    color: #94a3b8;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-pill);
    padding: 0.45rem 0.9rem;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .nav__parent:hover {
    color: var(--white);
    border-color: var(--blue);
  }
  @media (min-width: 900px) {
    .nav__links {
      display: flex;
    }
  }
</style>
