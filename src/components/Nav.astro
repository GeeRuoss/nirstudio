---
import { NAV, SITE } from '../data/site';
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label="NIR Studio, home">
      <!-- Logomark provisoire : double chevron spectral, à remplacer par le logo final -->
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <path d="M3 20L10 8l4 7 4-7 7 12" stroke="var(--blue)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="nav__name">NIR<b>STUDIO</b></span>
    </a>

    <nav class="nav__links" aria-label="Main">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a href={SITE.parent.url} class="nav__parent" target="_blank" rel="noopener">
      A 908 Devices Company
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: var(--ink);
    color: var(--white);
    border-bottom: 1px solid var(--border-dark);
  }
  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .nav__name {
    font-weight: 400;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }
  .nav__name b {
    font-weight: 800;
  }
  .nav__links {
    display: none;
    gap: 2rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .nav__links a {
    color: #cbd5e1;
    transition: color 0.2s ease;
  }
  .nav__links a:hover {
    color: var(--white);
  }
  .nav__parent {
    font-size: 0.78rem;
    font-weight: 600;
    color: #94a3b8;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-pill);
    padding: 0.45rem 0.9rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .nav__parent:hover {
    color: var(--white);
    border-color: var(--blue);
  }
  @media (min-width: 900px) {
    .nav__links {
      display: flex;
    }
  }
</style>
