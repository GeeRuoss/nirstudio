---
// Barre flottante en pilule (direction bikeverbier) : translucide + flou,
// se densifie au scroll, burger en mobile. Contact = bouton CTA à droite,
// logo 908devices (société mère) à côté.
import { NAV } from '../data/site';
import { withBase } from '../lib/url';

// Page active pour marquer le lien courant (chemin sans le base path).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.slice(base.length) || '/').replace(/\/$/, '') || '/';
const isActive = (href: string) => href !== '/#contact' && path.startsWith(href);

// Contact devient le bouton CTA : on le retire des liens.
const links = NAV.filter((item) => item.href !== '/#contact');
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a href={withBase('/')} class="nav__brand" aria-label="NIRStudio, a 908 Devices brand, home">
      <!-- Lockup : 908devices (societe) en principal, NIRStudio en sous-marque -->
      <img class="nav__brand-908" src={withBase('/img/908devices-logo-white.png')} alt="908 Devices" width="640" height="108" />
      <span class="nav__brand-sep" aria-hidden="true"></span>
      <span class="nav__brand-sub">
        <svg width="22" height="13" viewBox="0 0 92.13 53.19" fill="var(--blue)" aria-hidden="true">
          <polygon points="46.06 0 46.06 26.6 0 53.19 0 26.59 46.06 0" />
          <polygon points="92.13 0 92.13 26.6 46.07 53.19 46.06 53.19 46.06 26.6 92.13 0" />
        </svg>
        <span class="nav__name">NIR<b>STUDIO</b></span>
      </span>
    </a>

    <button class="burger" aria-label="Menu" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>

    <nav class="nav__menu" data-menu aria-label="Main">
      <ul class="nav__links">
        {
          links.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__right">
        <a class="nav__cta" href={withBase('/#contact')}>Contact</a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Pilule flottante translucide, se densifie au scroll */
  .nav {
    position: fixed;
    top: clamp(0.6rem, 1.5vw, 1.1rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: min(1180px, calc(100% - 1.4rem));
    border-radius: var(--radius-pill);
    background: rgba(12, 13, 16, 0.5);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    color: var(--white);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  .nav.is-solid {
    background: rgba(8, 9, 11, 0.85);
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.3);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.6rem 0.55rem 1.3rem;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }
  .nav__brand-908 {
    display: block;
    height: 17px;
    width: auto;
  }
  .nav__brand-sep {
    width: 1px;
    height: 22px;
    background: rgba(255, 255, 255, 0.22);
  }
  .nav__brand-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .nav__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.02rem;
    letter-spacing: 0.04em;
  }
  .nav__name b {
    font-weight: 700;
  }
  .nav__menu {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }
  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: #5e97f2;
  }
  .nav__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav__cta {
    display: inline-flex;
    align-items: center;
    background: var(--white);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.6rem 1.3rem;
    border-radius: var(--radius-pill);
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .nav__cta:hover {
    background: var(--blue);
    color: var(--white);
    transform: translateY(-1px);
  }
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 0.5rem 0.7rem;
    cursor: pointer;
  }
  .burger span {
    width: 26px;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .nav[data-open] .burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav[data-open] .burger span:nth-child(2) {
    opacity: 0;
  }
  .nav[data-open] .burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .burger {
      display: flex;
    }
    .nav__menu {
      position: absolute;
      inset: calc(100% + 0.6rem) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      background: rgba(10, 11, 13, 0.94);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      padding: 1.5rem;
      transform: translateY(-10px);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }
    .nav[data-open] .nav__menu {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
    .nav__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }
    .nav__links a {
      font-size: 1.05rem;
    }
    .nav__right {
      justify-content: space-between;
    }
    .nav__cta {
      flex: 1;
      justify-content: center;
    }
  }
  @media (max-width: 440px) {
    /* Tres petit ecran : le lockup garde 908devices + chevrons */
    .nav__name {
      display: none;
    }
    .nav__brand {
      gap: 0.65rem;
    }
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]');
  const burger = document.querySelector('[data-burger]');
  if (nav && burger) {
    const onScroll = () => nav.classList.toggle('is-solid', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    burger.addEventListener('click', () => {
      const open = nav.hasAttribute('data-open');
      nav.toggleAttribute('data-open');
      burger.setAttribute('aria-expanded', String(!open));
    });
    // Referme le menu mobile quand on suit un lien
    nav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        nav.removeAttribute('data-open');
        burger.setAttribute('aria-expanded', 'false');
      })
    );
  }
</script>
