---
// Section Solution : intro on-demand + render olives + les 3 étapes du process.
import SectionHead from './SectionHead.astro';
import { withBase } from '../lib/url';
import StepCard from './StepCard.astro';
import { STEPS } from '../data/site';
---

<section class="section" id="solution">
  <div class="container intro">
    <div class="reveal">
      <SectionHead
        kicker="Solution"
        title="The on-demand lab of 908&nbsp;Devices"
        lead="NIRLAB brought lab-grade NIR spectroscopy into a handheld device. Now part of 908 Devices, our studio builds the applications on top: custom models for your substances, your matrices and your field conditions. You bring the problem, we deliver the solution."
      />
    </div>
    <img
      src={withBase('/img/solution-olives.jpg')}
      alt="Handheld NIRLAB spectrometer with the mobile app showing oil and water content of an olive sample"
      width="1200"
      height="1000"
      loading="lazy"
      class="intro__img reveal"
    />
  </div>
  <div class="container">
    <div class="steps">
      {STEPS.map((step) => <StepCard n={step.n} title={step.title} text={step.text} />)}
    </div>
  </div>
</section>

<style>
  .intro {
    display: grid;
    gap: 3rem;
    align-items: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  /* Le SectionHead gère sa propre marge basse : on l'annule dans la grille intro */
  .intro :global(.section-head) {
    margin-bottom: 0;
  }
  .intro__img {
    width: min(460px, 85%);
    justify-self: center;
    height: auto;
  }
  .steps {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.2fr 1fr;
    }
    .intro__img {
      width: 100%;
    }
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
