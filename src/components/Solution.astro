---
// Section Solution : intro on-demand + photo de scan + lien vers la page /solution
// (les 3 étapes "Adding your material" vivent désormais sur /solution).
import SectionHead from './SectionHead.astro';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';
---

<section class="section" id="solution">
  <div class="container intro">
    <div class="reveal">
      <SectionHead
        kicker="Solution"
        title="From your data to your result"
        lead="It begins with your reference data — the real samples, the real conditions your team works in. A best-in-class NIR spectrometer scans them. Advanced modeling techniques turn those scans into a model trained on your material, not an industry average. And user-friendly software puts that model to work, turning every scan into an accurate result, on-site, in real time."
      />
      <a href={withBase('/solution')} class="intro__more">
        See how we build your model
        <Icon name="arrow" size={18} />
      </a>
    </div>
    <img
      src={withBase('/img/solution/scan-hands.jpg')}
      alt="Scanning real samples with the handheld NIR device, results in the mobile app"
      width="1800"
      height="1009"
      loading="lazy"
      class="intro__img reveal"
    />
  </div>
</section>

<style>
  .intro {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  /* Le SectionHead gère sa propre marge basse : on l'annule dans la grille intro */
  .intro :global(.section-head) {
    margin-bottom: 0;
  }
  .intro__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    font-weight: 700;
    color: var(--blue);
    transition: color 0.2s ease, gap 0.2s ease;
  }
  .intro__more:hover {
    color: var(--blue-dark, #023f9e);
    gap: 0.75rem;
  }
  .intro__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
