---
// Bandeau citation (fond sombre) : preuve ISO 17025, visuel device + Alpes (deck client).
import { QUOTE } from '../data/site';
import { withBase } from '../lib/url';
---

<section class="section section--dark">
  <div class="container quote-grid">
    <div class="quote reveal">
      <svg class="quote__mark" width="46" height="34" viewBox="0 0 46 34" fill="currentColor" aria-hidden="true">
        <path d="M0 34V20.4C0 8.8 6.4 1.6 17.6 0l2 5.6C12.4 7.6 9 11.2 8.8 16H18v18H0zm26 0V20.4C26 8.8 32.4 1.6 43.6 0l2 5.6C38.4 7.6 35 11.2 34.8 16H44v18H26z" />
      </svg>
      <blockquote>
        <p class="quote__text">{QUOTE.text}</p>
        <footer class="quote__author">
          {QUOTE.author} <span>{QUOTE.role}</span>
        </footer>
      </blockquote>
    </div>
    <img
      src={withBase('/img/quote-alps.jpg')}
      alt="The handheld NIR device and mobile app in front of snowy Swiss Alps"
      width="1600"
      height="908"
      loading="lazy"
      class="quote-grid__img reveal"
    />
  </div>
</section>

<style>
  .quote-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  .quote-grid__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-dark);
    box-shadow: 0 32px 64px rgba(0, 0, 0, 0.4);
  }
  @media (min-width: 980px) {
    .quote-grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }
  .quote__mark {
    color: var(--blue);
    margin-bottom: 1.75rem;
  }
  .quote__text {
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--white);
    text-wrap: balance;
  }
  .quote__author {
    margin-top: 1.75rem;
    font-weight: 700;
    color: var(--white);
  }
  .quote__author span {
    display: block;
    font-weight: 400;
    color: #9ca3af;
    font-size: 0.9rem;
  }
</style>
