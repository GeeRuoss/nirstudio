---
// Hero : les deux renders officiels 908 (matériaux + huile d'olive) en fondu
// enchaîné. Canvas étendus en noir vers le haut pour que le cover ne coupe rien.
import { withBase } from '../lib/url';
const heroBgs = [
  `--hero-bg: url('${withBase('/img/hero-bg.jpg')}')`,
  `--hero-bg: url('${withBase('/img/hero-bg-2.jpg')}')`,
];
---

<section class="hero">
  <div class="hero__bg" style={heroBgs[0]} aria-hidden="true"></div>
  <div class="hero__bg hero__bg--alt" style={heroBgs[1]} aria-hidden="true"></div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1>Your material, tested on the&nbsp;spot</h1>
      <p class="hero__lead">
        Every material is different, so every NIR model should be too. NIRStudio
        designs and builds a custom model around your specific samples — covering
        the full range of what you need to measure.
      </p>
      <div class="hero__cta">
        <a href="#contact" class="btn btn--primary">Request a solution</a>
        <a href="#video" class="btn btn--ghost">How it works</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #000;
    color: var(--text-on-dark);
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }
  /* Deux calques d'image en fondu enchaîné : l'alternance présente les deux renders */
  .hero__bg {
    position: absolute;
    inset: 0;
    background: var(--hero-bg) no-repeat right 68% / cover;
  }
  .hero__bg--alt {
    opacity: 0;
    animation: hero-swap 11s ease-in-out infinite;
  }
  @keyframes hero-swap {
    0%,
    36% {
      opacity: 0;
    }
    46%,
    86% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  /* Scrim gauche pour la lisibilité du copy quel que soit le calque affiché */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(4, 14, 24, 0.88) 0%, rgba(4, 14, 24, 0.55) 36%, rgba(4, 14, 24, 0) 62%);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .hero h1 {
    color: var(--white);
    max-width: 15ch;
    animation: hero-rise 0.7s ease both;
  }
  .hero__lead {
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    color: #c7d0d8;
    max-width: 32rem;
    animation: hero-rise 0.7s 0.12s ease both;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
    animation: hero-rise 0.7s 0.24s ease both;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 700px) {
    /* En mobile le produit reste visible mais sous un voile pour la lisibilité du texte */
    .hero__bg {
      background-position: 72% bottom;
    }
    .hero__scrim {
      background: linear-gradient(180deg, rgba(8, 14, 20, 0.3) 0%, rgba(8, 14, 20, 0.78) 55%, rgba(8, 14, 20, 0.9) 100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero h1,
    .hero__lead,
    .hero__cta {
      animation: none;
    }
    .hero__bg--alt {
      animation: none;
      opacity: 0;
    }
  }
</style>
