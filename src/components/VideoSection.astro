---
// Vidéo de présentation "NIRStudio - Applications" (source Wistia 908 Devices,
// self-hostée en 1080p conformément à la règle assets locaux).
import SectionHead from './SectionHead.astro';
import { withBase } from '../lib/url';
---

<section class="section section--dark" id="video">
  <div class="container">
    <div class="reveal">
      <SectionHead kicker="In action" title="The solution for solid and liquid analysis" />
    </div>
    <div class="promo reveal">
      <video
        preload="metadata"
        playsinline
        poster={withBase('/video/nirstudio-applications-poster.jpg')}
        width="1920"
        height="1080"
      >
        <source src={withBase('/video/nirstudio-applications.mp4')} type="video/mp4" />
        Your browser does not support the video tag.
      </video>
      <button class="promo__watch" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.5v13l11-6.5-11-6.5z" />
        </svg>
        Watch
      </button>
    </div>
  </div>
</section>

<script>
  const promo = document.querySelector<HTMLElement>('.promo');
  const video = promo?.querySelector('video');
  const watch = promo?.querySelector<HTMLButtonElement>('.promo__watch');
  if (video && watch) {
    watch.addEventListener('click', () => {
      watch.hidden = true;
      video.setAttribute('controls', '');
      video.play();
    });
    // Si l'utilisateur lance la lecture autrement (clavier), on retire aussi le bouton
    video.addEventListener('play', () => {
      watch.hidden = true;
      video.setAttribute('controls', '');
    });
  }
</script>

<style>
  .promo {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border-dark);
    background: var(--ink);
    box-shadow: 0 32px 64px rgba(0, 0, 0, 0.45);
  }
  .promo video {
    display: block;
    width: 100%;
    height: auto;
  }
  .promo__watch {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.9rem;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--blue);
    font-weight: 700;
    font-size: 1.02rem;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.45);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .promo__watch:hover {
    transform: translate(-50%, -50%) scale(1.05);
    box-shadow: 0 20px 52px rgba(0, 0, 0, 0.55);
  }
</style>
